# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# Virtual environments
venv/
.venv/
env/

# Data and model artifacts
data/*.csv
data/*.tsv
data/*.txt
data/*.gz
data/*.zip
# Taobao and Avazu raw files and anything derived from them. The licence
# terms say code and aggregates only, never the rows.
data/taobao/
data/avazu/
data/synthetic_ids/
data/*.parquet
# Model artifacts, at any depth under results. The double star matters because
# a pulled results directory from a remote run nests one level deeper, and a
# single star pattern silently fails to match it.
results/**/*.pt
results/**/*.pth
results/**/*.pkl
results/**/*.onnx
results/**/*.onnx.data
results/*.pt
results/*.pth
results/*.pkl
results/*.onnx
results/*.onnx.data
# Retrieval artifacts: tower weights, corpus embeddings and FAISS indexes.
# Embeddings are derived from the dataset, so they stay local like the rows.
results/**/*.npy
results/**/*.npz
results/**/*.faiss
results/**/artifacts/

# Serialized TensorRT engines. These are hundreds of megabytes and are tied to
# the gpu architecture, the driver, and the TensorRT version that built them, so
# they are rebuilt on the serving machine rather than committed. The INT8
# calibration cache and the build report next to them are small, portable, and
# are kept, because they are what makes a reported INT8 number auditable.
results/**/*.engine
results/**/*.plan
results/trt/*.engine
results/trt/*.plan
results/trt/ort_trt_cache/

# Generated data artifacts. These are outputs of a pipeline rather than source,
# they are regenerated by one command, and some of them are large. The reports,
# the charts, and the committed regression baselines next to them are small and
# are kept, because those are what make a reported number auditable.
results/features.parquet/
results/*.parquet
results/serving/*.parquet
results/serving/bundle/
results/sweeps/

# OS
.DS_Store

# Internal build specification (kept local, not part of the public portfolio)
ClickRank_CLAUDE.md

# Keep directory placeholders
!data/download.sh
!results/.gitkeep
